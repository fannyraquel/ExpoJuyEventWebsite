# ==========================================
# ExpoJuy 2026 — Ejemplo de Variables de Entorno
# Copiar este archivo como '.env' para desarrollo local
# ==========================================

# Configuración del Sitio
VITE_APP_TITLE="ExpoJuy 2026"
VITE_MODE="development"

# Configuración del Backend API REST
VITE_API_BASE_URL="https://api.expojuy.gob.ar/v1"
VITE_API_TIMEOUT=10000

# Capa de Seguridad Transaccional SHA-256
VITE_ENABLE_SHA256_SIGNATURE="true"
VITE_API_SECRET_KEY="tu_clave_secreta_sha256_aqui"

# Configuración de Idioma por Defecto
VITE_DEFAULT_LANGUAGE="ES"
